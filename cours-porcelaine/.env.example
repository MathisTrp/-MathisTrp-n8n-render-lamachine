# Clé API SumUp (Dashboard SumUp > Réglages > API personnelle / API keys)
SUMUP_API_KEY=

# Code marchand SumUp (Dashboard SumUp > Réglages du compte > "Merchant code")
SUMUP_MERCHANT_CODE=

# Mot de passe pour accéder à l'interface d'administration (page /admin)
ADMIN_PASSWORD=

# URL publique du site une fois déployé, sans "/" à la fin.
# Sert à construire le lien de retour après paiement (redirect_url).
# Exemple : https://cours-de-ma-mere.vercel.app
PUBLIC_BASE_URL=

# URL du webhook n8n à appeler une fois le paiement confirmé.
# Optionnel : à renseigner seulement quand api/webhook.js sera activé.
# N8N_WEBHOOK_URL=

# Clé API Resend (resend.com), pour l'envoi automatique des e-mails :
# confirmation à la cliente + notification à l'administratrice.
# Optionnel : tant qu'elle n'est pas renseignée, les e-mails sont juste
# ignorés (rien ne casse).
RESEND_API_KEY=

# Adresse d'expédition des e-mails, au format "Nom <adresse@domaine>".
# Doit appartenir à un domaine vérifié dans Resend (voir le README) —
# ou, pour tester rapidement, "Cours de porcelaine <onboarding@resend.dev>".
EMAIL_FROM=

# Adresse e-mail de l'administratrice, qui recevra une notification à
# chaque nouvelle inscription.
ADMIN_EMAIL=
